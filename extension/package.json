{
  "name": "ketchup",
  "displayName": "Ketchup",
  "description": "Detect and sync drift between local workspace and expected state",
  "version": "0.2.0",
  "publisher": "ketchup-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ketchup-ai/ketchup.git"
  },
  "bugs": {
    "url": "https://github.com/ketchup-ai/ketchup/issues"
  },
  "homepage": "https://github.com/ketchup-ai/ketchup#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:ketchupView",
    "onCommand:ketchup.status",
    "onCommand:ketchup.diff",
    "onCommand:ketchup.sync",
    "onCommand:ketchup.doctor",
    "onCommand:ketchup.catchup",
    "onCommand:ketchup.update",
    "workspaceContains:.ketchup.yml",
    "workspaceContains:.ketchup.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ketchup-container",
          "title": "Ketchup",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "ketchup-container": [
        {
          "id": "ketchupView",
          "name": "Ketchup Status",
          "icon": "$(git-pull-request)",
          "contextualTitle": "Ketchup"
        }
      ]
    },
    "commands": [
      {
        "command": "ketchup.refresh",
        "title": "Refresh Ketchup Status",
        "icon": "$(refresh)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.status",
        "title": "Check Status",
        "icon": "$(info)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.diff",
        "title": "Show Diff",
        "icon": "$(diff)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.sync",
        "title": "Sync Workspace",
        "icon": "$(sync)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.doctor",
        "title": "Run Doctor",
        "icon": "$(wrench)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.catchup",
        "title": "Catch Up",
        "icon": "$(arrow-up)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.catchup.all",
        "title": "Catch Up (Show All Changes)",
        "icon": "$(list-unordered)",
        "category": "Ketchup"
      },
      {
        "command": "ketchup.update",
        "title": "Check for Updates",
        "icon": "$(cloud-download)",
        "category": "Ketchup"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ketchup.refresh",
          "when": "view == ketchupView",
          "group": "navigation"
        },
        {
          "command": "ketchup.update",
          "when": "view == ketchupView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ketchup.diff",
          "when": "view == ketchupView && viewItem == provider",
          "group": "inline"
        },
        {
          "command": "ketchup.sync",
          "when": "view == ketchupView && viewItem == finding",
          "group": "inline"
        },
        {
          "command": "ketchup.catchup",
          "when": "view == ketchupView && viewItem == git-provider",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "ketchup.status",
          "group": "ketchup"
        },
        {
          "command": "ketchup.sync",
          "group": "ketchup"
        }
      ],
      "editor/title": [
        {
          "command": "ketchup.diff",
          "when": "resourceLangId == yaml && resourceFilename =~ /\\.ketchup\\.(yml|yaml)/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ketchup",
      "properties": {
        "ketchup.cliPath": {
          "type": "string",
          "default": "ketchup",
          "description": "Path to the Ketchup CLI executable"
        },
        "ketchup.autoCheckOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check status when workspace opens"
        },
        "ketchup.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for drift detection"
        },
        "ketchup.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check for Ketchup core updates on startup"
        },
        "ketchup.updateChannel": {
          "type": "string",
          "default": "stable",
          "enum": ["stable", "beta", "nightly"],
          "description": "Update channel for Ketchup core"
        },
        "ketchup.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Ketchup status in the status bar"
        },
        "ketchup.catchUpShow": {
          "type": "string",
          "default": "relevant",
          "enum": ["relevant", "all"],
          "enumDescriptions": [
            "Show only changes Ketchup considers relevant to your current work",
            "Show all changes including ignored/irrelevant events"
          ],
          "description": "Catch-up display mode (overridden by ketchup.catchup.show in .ketchup.yaml when CLI reads project config)"
        },
        "ketchup.catchUpExplain": {
          "type": "boolean",
          "default": false,
          "description": "Include relevance scores and scoring breakdown in catch-up output"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
